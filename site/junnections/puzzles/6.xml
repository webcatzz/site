	<style>
audio-trigger {
	cursor: pointer;
	&:hover {scale: 1.1}
	&::after {content: url(data:image/svg+xml;base64,)}
}
	</style>
	<script>
let audio = new Audio;
class AudioTrigger extends HTMLElement {
	constructor() {
		super();
		this.addEventListener("click", this.onClick);
	}
	onClick(e) {
		e.stopPropagation();
		if (audio.src == this.getAttribute("src")) audio.paused ? audio.play() : audio.pause();
		else {
			audio.src = this.getAttribute("src");
			audio.play();
		}
	}
}
customElements.define("audio-trigger", AudioTrigger);
	</script>
